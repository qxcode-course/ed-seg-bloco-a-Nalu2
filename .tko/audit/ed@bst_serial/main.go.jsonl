{"ts":1783901778,"hash":"806da2899a0f59707bfdf84a0e81aa0aa0725b0a3ddd3787c43a6fd7cc2712f4","mode":"diff","ops":[{"tag":"insert","a1":16,"a2":16,"text":"func insert(node *Node, val int) *Node {\n\tif node == nil {\n\t\treturn &Node{Value: val}\n\t}\n\tif val < node.Value {\n\t\tnode.Left = insert(node.Left, val)\n\t} else if val > node.Value {\n\t\tnode.Right = insert(node.Right, val)\n\t}\n\treturn node\n}\n\n"},{"tag":"replace","a1":17,"a2":20,"text":"\tvar root *Node\n\tfor _, val := range values {\n\t\troot = insert(root, val)\n\t}\n\treturn root\n"},{"tag":"insert","a1":21,"a2":21,"text":"\n\n"}]}
