{"ts":1783881302,"hash":"545bccbb72b5d62609023c5705789e5b211cc04a778c0473e120a8bb5327982b","mode":"diff","ops":[{"tag":"insert","a1":9,"a2":9,"text":"\ntype Node struct {\n\tValue int\n\tLeft *Node\n\tRight *Node\n}\n\nfunc find(node *Node, value int) *Node {\n\tif node == nil {\n\t\treturn nil \n\t}\n\tif node.Value == value {\n\t\treturn node\n\t}\n\tleftResult != find(node.Left, value)\n\tif leftResult := nil {\n\t\treturn leftResult\n\t}\n\treturn find(node.Right, value)\n\n}\n\n\n"}]}
