{"ts":1783905243,"hash":"c91a385a6723210608077eac528cc7ffa1c30a9fae17a09f0b2e0aa1a09a4dc3","mode":"diff","ops":[{"tag":"insert","a1":8,"a2":8,"text":"func dsf(grid [][]byte, r, c int){\n\tif r<0 || r >= len(grid) || c <0 || c>= len(grid[0]) || grid[r][c] == '0'{\n\t\treturn\n\t}\n\tgrid[r][c] ='0'\n\tdsf(grid, r+1, c)\n\tdsf(grid, r-1, c)\n\tdsf(grid, r, c+1)\n\tdsf(grid, r, c-1)\n}\n\n"},{"tag":"replace","a1":13,"a2":14,"text":"\treturn 0\n"}]}
{"ts":1783905662,"hash":"ccfc413f39ab66f87b666cddc0e92505ffdbdfdf760c44a71e8508eec578abaf","mode":"diff","ops":[{"tag":"replace","a1":22,"a2":25,"text":"\tif len(grid) == 0{\n\t\treturn 0\n\t}\n\tcount := 0\n\tfor r := 0; r< len(grid); r ++{\n\t\tfor c :=0; c < len(grid[0]); c++ {\n\t\t\tif grid[r][c] == '1'{\n\t\t\t\tcount ++\n\t\t\t\tdsf(grid,r,c)\n\t\t\t}\n\t\t}\n\t}\n\treturn count\n"}]}
